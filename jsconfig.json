{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "typeAcquisition": {
    "enable": true,
    "include": ["jquery"]
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "**/node_modules/*"]
}